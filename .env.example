# GEMINI_API_KEY: Required for server-side Gemini calls in the live Node/Express app.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_API_KEY: Used by the standalone Python/FastAPI mirror in /backend when running locally on Ubuntu.
GOOGLE_API_KEY="MY_GOOGLE_API_KEY"

# GROQ_API_KEY: Optional free-tier fallback provider for Llama 3.3 70B via Groq.
GROQ_API_KEY="MY_GROQ_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
