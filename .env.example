# GEMINI_API_KEY: Required for server-side Gemini Flash calls in the live Node/Express app.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# GOOGLE_API_KEY: Used by the standalone Python/FastAPI mirror in /backend when running locally on Ubuntu.
GOOGLE_API_KEY="MY_GOOGLE_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
